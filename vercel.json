{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/d/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/es/d/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ai/:path*",
      "destination": "https://unboundoperators.app/api/ai/:path*"
    },
    {
      "source": "/ai/recursos/:key",
      "destination": "/ai/recursos/_"
    },
    {
      "source": "/en/ai/recursos/:key",
      "destination": "/en/ai/recursos/_"
    }
  ],
  "redirects": [
    {
      "source": "/grow",
      "destination": "/en/grow",
      "permanent": true
    },
    {
      "source": "/en/crecer",
      "destination": "/en/grow",
      "permanent": true
    },
    {
      "source": "/es/crecer",
      "destination": "/crecer",
      "permanent": true
    },
    {
      "source": "/es/geo",
      "destination": "/geo",
      "permanent": true
    },
    {
      "source": "/sobre-mi",
      "destination": "/es/sobre-mi",
      "permanent": true
    },
    {
      "source": "/es/about",
      "destination": "/es/sobre-mi",
      "permanent": true
    },
    {
      "source": "/en/about",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/kit/deck",
      "destination": "/en/kit/deck",
      "permanent": false
    },
    {
      "source": "/kit/raise",
      "destination": "/en/kit/raise",
      "permanent": false
    },
    {
      "source": "/kit/pipeline",
      "destination": "/en/kit/pipeline",
      "permanent": false
    },
    {
      "source": "/kit/focus",
      "destination": "/en/kit/focus",
      "permanent": false
    },
    {
      "source": "/kit/loop",
      "destination": "/en/kit/loop",
      "permanent": false
    },
    {
      "source": "/en/kit/medir",
      "destination": "/kit/medir",
      "permanent": false
    },
    {
      "source": "/en/kit/foco",
      "destination": "/kit/foco",
      "permanent": false
    },
    {
      "source": "/en/kit/ventas",
      "destination": "/kit/ventas",
      "permanent": false
    },
    {
      "source": "/en/kit/marca",
      "destination": "/kit/marca",
      "permanent": false
    },
    {
      "source": "/es/kit/:path*",
      "destination": "/kit/:path*",
      "permanent": false
    },
    {
      "source": "/es/kit",
      "destination": "/kit",
      "permanent": false
    },
    {
      "source": "/kits",
      "destination": "/kit",
      "permanent": false
    }
  ]
}
