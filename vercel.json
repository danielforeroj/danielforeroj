{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/ai/:path*",
      "destination": "https://unboundoperators.app/api/ai/:path*"
    },
    {
      "source": "/ai/recursos/:key",
      "destination": "/ai/recursos/_"
    },
    {
      "source": "/en/ai/recursos/:key",
      "destination": "/en/ai/recursos/_"
    }
  ],
  "redirects": [
    {
      "source": "/grow",
      "destination": "/en/grow",
      "permanent": true
    },
    {
      "source": "/en/crecer",
      "destination": "/en/grow",
      "permanent": true
    },
    {
      "source": "/es/crecer",
      "destination": "/crecer",
      "permanent": true
    },
    {
      "source": "/es/geo",
      "destination": "/geo",
      "permanent": true
    },
    {
      "source": "/sobre-mi",
      "destination": "/es/sobre-mi",
      "permanent": true
    },
    {
      "source": "/es/about",
      "destination": "/es/sobre-mi",
      "permanent": true
    },
    {
      "source": "/en/about",
      "destination": "/about",
      "permanent": true
    }
  ]
}
